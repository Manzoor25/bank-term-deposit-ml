# Copy this file to .env if you want to override the defaults in config.py.
# .env is gitignored. Do not put passwords in Git.
#
# Leave AZURE_SUBSCRIPTION_ID empty to use whatever `az account show` returns.

AZURE_SUBSCRIPTION_ID=
